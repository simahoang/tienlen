{
  "name": "tien-len-mien-nam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:full": "playwright test tests/e2e/full-game.spec.ts",
    "verify:fast": "npm run typecheck && npm run lint && npm test",
    "server:dev": "node --env-file-if-exists=.env --import tsx --watch server/main.ts",
    "server:start": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "server:build": "tsc --noEmit",
    "server:test": "vitest run tests/server"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
